{
  "schema_version": "1.0",
  "brand": "cococoal",
  "rules": [
    {
      "id": "GR-001",
      "name": "Monitor ROAS Ratio",
      "category": "campaign_launch",
      "severity": "warn",
      "derived_from": "ROAS Underclaim Analysis",
      "condition": {
        "metric": "platform_roas_to_true_roas_ratio",
        "operator": "lt",
        "threshold": 10
      },
      "reason": "Substantial discrepancy between platform reported ROAS and true ROAS."
    },
    {
      "id": "GR-002",
      "name": "High Social to Acquisition Rate",
      "category": "campaign_launch",
      "severity": "pass",
      "derived_from": "Social Lift Success",
      "condition": {
        "metric": "social_to_acq_rate",
        "operator": "gt",
        "threshold": 12
      },
      "reason": "Indicates exceptional conversion efficiency from social reach."
    },
    {
      "id": "GR-003",
      "name": "Assess Sentiment Discrepancy",
      "category": "customer_interaction",
      "severity": "warn",
      "derived_from": "ROAS and Sentiment Analysis",
      "condition": {
        "metric": "sentiment_mismatch",
        "operator": "gt",
        "threshold": 0.1
      },
      "reason": "Potential misalignment between customer sentiment and reported satisfaction."
    },
    {
      "id": "GR-004",
      "name": "Check Health Score",
      "category": "product_launch",
      "severity": "warn",
      "derived_from": "ROAS and Product Health Correlation",
      "condition": {
        "metric": "health_score",
        "operator": "lt",
        "threshold": 70
      },
      "reason": "Product health scores fall below optimal threshold, potentially affecting reputation."
    },
    {
      "id": "GR-005",
      "name": "Review Customer Support Load",
      "category": "customer_interaction",
      "severity": "warn",
      "derived_from": "Customer Support Analysis",
      "condition": {
        "metric": "customer.support_tickets",
        "operator": "gt",
        "threshold": 100
      },
      "reason": "Increased volume of support tickets indicating potential customer service issues."
    },
    {
      "id": "GR-006",
      "name": "Evaluate Refund Rate",
      "category": "customer_interaction",
      "severity": "warn",
      "derived_from": "Refund Analysis",
      "condition": {
        "metric": "refund_rate",
        "operator": "gt",
        "threshold": 0.05
      },
      "reason": "Higher than acceptable refund rates affecting profitability."
    },
    {
      "id": "GR-007",
      "name": "CX Risk Evaluation",
      "category": "customer_interaction",
      "severity": "block",
      "derived_from": "CX Risk Assessment",
      "condition": {
        "metric": "cx_risk_score",
        "operator": "gt",
        "threshold": 0.4
      },
      "reason": "Urgent risk to customer experience metrics that must be addressed."
    },
    {
      "id": "GR-008",
      "name": "Analyze Customer NPS",
      "category": "customer_interaction",
      "severity": "warn",
      "derived_from": "Customer Satisfaction Survey",
      "condition": {
        "metric": "customer.nps",
        "operator": "lt",
        "threshold": 30
      },
      "reason": "NPS indicating low customer loyalty and satisfaction."
    },
    {
      "id": "GR-009",
      "name": "Enhance Product Rating",
      "category": "product_launch",
      "severity": "warn",
      "derived_from": "Product Rating Insights",
      "condition": {
        "metric": "customer.avg_rating",
        "operator": "lt",
        "threshold": 3.5
      },
      "reason": "Average product ratings below desired metrics requiring improvement."
    },
    {
      "id": "GR-010",
      "name": "Social Engagement Watch",
      "category": "campaign_launch",
      "severity": "warn",
      "derived_from": "Social Engagement Analysis",
      "condition": {
        "metric": "social.reach",
        "operator": "lt",
        "threshold": 50000
      },
      "reason": "Social reach falling below effective engagement levels for campaign success."
    },
    {
      "id": "GR-011",
      "name": "Inventory Confirmation",
      "category": "product_launch",
      "severity": "block",
      "derived_from": "Inventory Check",
      "condition": {
        "metric": "inventory_confirmed",
        "operator": "eq",
        "threshold": false
      },
      "reason": "Unconfirmed inventory that could disrupt product launch plans."
    },
    {
      "id": "GR-012",
      "name": "Consistency in Review Sentiment",
      "category": "customer_interaction",
      "severity": "warn",
      "derived_from": "Review Sentiment Analysis",
      "condition": {
        "metric": "customer.review_sentiment",
        "operator": "lt",
        "threshold": 0.6
      },
      "reason": "Review sentiment hints at potential dissatisfaction among customers."
    }
  ]
}